---
interface Props {
  page?: string;
}

const { page = 'current' } = Astro.props;
---

<div class="feedback-widget" id="feedback-widget">
  <p class="feedback-title">Esta página foi útil?</p>
  <div class="feedback-buttons">
    <button class="feedback-btn feedback-yes" id="feedback-yes" aria-label="Sim, a página foi útil">
      Sim
    </button>
    <button class="feedback-btn feedback-no" id="feedback-no" aria-label="Não, a página não foi útil">
      Não
    </button>
  </div>
  <div class="feedback-form" id="feedback-form" style="display: none;">
    <textarea 
      class="feedback-textarea" 
      id="feedback-text" 
      placeholder="Obrigado! Como podemos melhorar?"
      rows="3"
    ></textarea>
    <button class="feedback-submit" id="feedback-submit">
      Enviar
    </button>
  </div>
  <p class="feedback-thanks" id="feedback-thanks" style="display: none;">
    Obrigado pelo seu feedback!
  </p>
</div>

<script>
  const widget = document.getElementById('feedback-widget');
  const yesBtn = document.getElementById('feedback-yes');
  const noBtn = document.getElementById('feedback-no');
  const form = document.getElementById('feedback-form');
  const textArea = document.getElementById('feedback-text');
  const submitBtn = document.getElementById('feedback-submit');
  const thanks = document.getElementById('feedback-thanks');
  
  let feedbackValue: 'yes' | 'no' | null = null;
  
  function handleFeedback(value: 'yes' | 'no') {
    feedbackValue = value;
    if (value === 'yes') {
      showThanks();
    } else {
      showForm();
    }
  }
  
  function showForm() {
    yesBtn?.setAttribute('style', 'display: none;');
    noBtn?.setAttribute('style', 'display: none;');
    form?.removeAttribute('style');
    textArea?.focus();
  }
  
  function showThanks() {
    yesBtn?.setAttribute('style', 'display: none;');
    noBtn?.setAttribute('style', 'display: none;');
    form?.setAttribute('style', 'display: none;');
    thanks?.removeAttribute('style');
    
    setTimeout(() => {
      widget?.setAttribute('style', 'display: none;');
    }, 3000);
  }
  
  function submitFeedback() {
    const text = (document.getElementById('feedback-text') as HTMLTextAreaElement)?.value || '';
    
    const data = {
      page: window.location.pathname,
      feedback: feedbackValue,
      comment: text,
      timestamp: new Date().toISOString()
    };
    
    console.log('Feedback submitted:', data);
    
    showThanks();
  }
  
  yesBtn?.addEventListener('click', () => handleFeedback('yes'));
  noBtn?.addEventListener('click', () => handleFeedback('no'));
  submitBtn?.addEventListener('click', submitFeedback);
  
  textArea?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      submitFeedback();
    }
  });
</script>

<style>
  .feedback-widget {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    box-shadow: 0 8px 28px rgba(35, 32, 47, 0.14);
    z-index: 100;
    max-width: 280px;
    font-size: 0.9rem;
    font-family: inherit;
  }
  
  [data-theme='dark'] .feedback-widget {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
  
  .feedback-title {
    margin: 0 0 0.75rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }
  
  .feedback-buttons {
    display: flex;
    gap: 0.5rem;
  }
  
  .feedback-btn {
    flex: 1;
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s var(--motion-ease-out);
  }
  
  .feedback-btn:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-accent);
  }
  
  .feedback-yes:hover {
    border-color: #22c55e;
    color: #22c55e;
  }
  
  .feedback-no:hover {
    border-color: #ef4444;
    color: #ef4444;
  }
  
  .feedback-form {
    margin-top: 0.75rem;
  }
  
  .feedback-textarea {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-3);
    border-radius: 8px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    resize: vertical;
    font-family: inherit;
    font-size: 0.875rem;
  }
  
  .feedback-textarea:focus {
    outline: none;
    border-color: var(--sl-color-accent);
  }
  
  .feedback-submit {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: var(--sl-color-accent);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s var(--motion-ease-out);
  }
  
  .feedback-submit:hover {
    background: var(--sl-color-accent-high);
  }
  
  .feedback-thanks {
    margin: 0;
    color: #22c55e;
    font-weight: 600;
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .feedback-widget {
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      max-width: none;
      /* Acima do home indicator em iPhones com gesture bar. */
      padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    }

    /* Alvos de toque com 44px mínimos. */
    .feedback-btn,
    .feedback-submit {
      min-height: 44px;
    }

    /* <16px em inputs = Safari iOS dá auto-zoom ao focar. */
    .feedback-textarea {
      font-size: 16px;
    }
  }
</style>
