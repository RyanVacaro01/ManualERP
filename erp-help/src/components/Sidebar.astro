---
import { getIcon, renderGroup } from '../lib/sidebar';

const { sidebar } = Astro.locals.starlightRoute;
const navHtml = sidebar.map((group) => renderGroup(group)).join('');
const headphonesIconHtml = getIcon('headphones');
const chevronLeftIconHtml = getIcon('chevron-left');
const menuIconHtml = getIcon('menu');
---

<style is:global>
  .sidebar-wrapper {
    --sb-bg: var(--sl-color-bg-sidebar);
    --sb-border: var(--sl-color-gray-2);
    --sb-text: var(--sl-color-text);
    --sb-muted: var(--sl-color-text-muted);
    --sb-hover: var(--sl-color-gray-1);
    --sb-active-bg: var(--sl-color-accent-low);
    --sb-accent: var(--sl-color-accent);
    --sb-radius: 7px;
    --sb-ease: cubic-bezier(0.4, 0, 0.2, 1);

    display: flex;
    flex-direction: column;
    width: var(--sl-sidebar-width, 276px);
    height: calc(100vh - var(--sl-nav-height));
    height: calc(100dvh - var(--sl-nav-height));
    background: var(--sb-bg);
    position: fixed;
    left: 0;
    top: var(--sl-nav-height);
    z-index: 1;
    overflow: hidden;
    transition: width 0.22s var(--sb-ease), transform 0.25s var(--sb-ease);
  }

  /* ---------- Header (fixo) ---------- */
  .sidebar-wrapper .sidebar-header {
    flex-shrink: 0;
    padding: 16px 14px 12px;
    border-bottom: 1px solid var(--sb-border);
    background: var(--sb-bg);
    z-index: 2;
  }

  .sidebar-wrapper .brand-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .sidebar-wrapper .brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--sb-accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .sidebar-wrapper .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
    flex: 1;
  }

  .sidebar-wrapper .brand-title {
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sb-text);
    white-space: nowrap;
  }

  .sidebar-wrapper .brand-subtitle {
    font-size: 11px;
    font-weight: 500;
    color: var(--sb-muted);
    white-space: nowrap;
  }

  .sidebar-wrapper .collapse-btn {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--sb-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.16s ease;
  }

  .sidebar-wrapper .collapse-btn:hover {
    background: var(--sb-hover);
    color: var(--sb-text);
    border-color: var(--sb-border);
  }

  .sidebar-wrapper .collapse-btn:focus-visible {
    outline: none;
    border-color: var(--sb-accent);
    box-shadow: 0 0 0 2px var(--sb-active-bg);
  }

  .sidebar-wrapper .collapse-btn .icon-svg {
    width: 15px;
    height: 15px;
    transition: transform 0.22s var(--sb-ease);
  }

  .sidebar-wrapper.collapsed .collapse-btn .icon-svg {
    transform: rotate(180deg);
  }

  /* A busca oficial fica no header (Pagefind, Ctrl+K nativo). */

  /* ---------- Navegação (scroll independente) ---------- */
  .sidebar-wrapper .sidebar {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    min-width: 0;
  }

  .sidebar-wrapper .sidebar-nav {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 10px 10px 16px;
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }

  .sidebar-wrapper .sidebar-nav:hover {
    scrollbar-color: var(--sl-color-gray-3) transparent;
  }

  .sidebar-wrapper .sidebar-nav::-webkit-scrollbar {
    width: 5px;
  }

  .sidebar-wrapper .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-wrapper .sidebar-nav::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 4px;
  }

  .sidebar-wrapper .sidebar-nav:hover::-webkit-scrollbar-thumb {
    background: var(--sl-color-gray-3);
  }

  .sidebar-wrapper .sidebar-section {
    margin-bottom: 14px;
  }

  .sidebar-wrapper .sidebar-section:last-child {
    margin-bottom: 0;
  }

  .sidebar-wrapper .section-header {
    padding: 6px 10px;
    margin-bottom: 2px;
  }

  .sidebar-wrapper .section-title {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--sb-muted);
    margin: 0;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-wrapper .section-icon {
    display: none;
  }

  .sidebar-wrapper .section-content {
    overflow: hidden;
  }

  /* ---------- Itens ---------- */
  .sidebar-wrapper .sidebar-item,
  .sidebar-wrapper .sidebar-group-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    padding: 8px 10px 8px calc(10px + var(--indent, 0px));
    border-radius: var(--sb-radius);
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--sb-text);
    text-decoration: none;
    position: relative;
    width: 100%;
    border: none;
    background: transparent;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .sidebar-wrapper .sidebar-item {
    font-weight: 450;
  }

  .sidebar-wrapper .sidebar-group-toggle {
    font-weight: 550;
  }

  .sidebar-wrapper .sidebar-item:hover,
  .sidebar-wrapper .sidebar-group-toggle:hover {
    background: var(--sb-hover);
    text-decoration: none;
  }

  .sidebar-wrapper .sidebar-item:focus-visible,
  .sidebar-wrapper .sidebar-group-toggle:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--sb-accent);
  }

  .sidebar-wrapper .item-icon,
  .sidebar-wrapper .group-icon {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sb-muted);
    flex-shrink: 0;
    transition: color 0.16s ease;
  }

  .sidebar-wrapper .item-icon .icon-svg,
  .sidebar-wrapper .group-icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .sidebar-wrapper .sidebar-item:hover .item-icon,
  .sidebar-wrapper .sidebar-group-toggle:hover .group-icon {
    color: var(--sb-text);
  }

  .sidebar-wrapper .item-label,
  .sidebar-wrapper .group-label {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- Item ativo: elegante e discreto ---------- */
  .sidebar-wrapper .sidebar-item.active,
  .sidebar-wrapper .sidebar-group-toggle.active {
    background: var(--sb-active-bg);
    color: var(--sb-text);
    font-weight: 600;
  }

  .sidebar-wrapper .sidebar-item.active .item-icon,
  .sidebar-wrapper .sidebar-group-toggle.active .group-icon {
    color: var(--sb-accent);
  }

  .sidebar-wrapper .active-indicator {
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    width: 2.5px;
    border-radius: 0 3px 3px 0;
    background: var(--sb-accent);
  }

  /* ---------- Submenus ---------- */
  .sidebar-wrapper .sidebar-group-content {
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.22s var(--sb-ease), opacity 0.18s ease;
    opacity: 1;
  }

  .sidebar-wrapper .sidebar-group-content:not(.open) {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .sidebar-wrapper .sidebar-group-content > .sidebar-group-inner {
    overflow: hidden;
    min-height: 0;
  }

  .sidebar-wrapper .sidebar-group.depth-0 {
    margin-bottom: 1px;
  }

  .sidebar-wrapper .sidebar-item.depth-1,
  .sidebar-wrapper .sidebar-group.depth-1 {
    font-size: 13px;
  }

  .sidebar-wrapper .sidebar-item.depth-2 {
    font-size: 12.5px;
    min-height: 34px;
    color: var(--sb-muted);
  }

  .sidebar-wrapper .sidebar-item.depth-2:hover,
  .sidebar-wrapper .sidebar-item.depth-2.active {
    color: var(--sb-text);
  }

  .sidebar-wrapper .chevron {
    display: inline-flex;
    color: var(--sb-muted);
    flex-shrink: 0;
  }

  .sidebar-wrapper .chevron .icon-svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s var(--sb-ease);
  }

  .sidebar-wrapper .sidebar-group-toggle.expanded .chevron .icon-svg {
    transform: rotate(90deg);
  }

  /* ---------- Rodapé ---------- */
  .sidebar-wrapper .sidebar-footer {
    flex-shrink: 0;
    padding: 12px 14px;
    border-top: 1px solid var(--sb-border);
    background: var(--sb-bg);
  }

  .sidebar-wrapper .footer-version {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--sb-muted);
    margin-bottom: 8px;
  }

  .sidebar-wrapper .version-badge {
    font-family: ui-monospace, monospace;
    font-weight: 600;
    font-size: 10.5px;
    background: var(--sb-hover);
    border: 1px solid var(--sb-border);
    padding: 1px 7px;
    border-radius: 5px;
    color: var(--sb-text);
  }

  .sidebar-wrapper .footer-link {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border-radius: var(--sb-radius);
    font-size: 13px;
    font-weight: 550;
    color: var(--sb-text);
    text-decoration: none;
    transition: background 0.16s ease, color 0.16s ease;
  }

  .sidebar-wrapper .footer-link:hover {
    background: var(--sb-hover);
    color: var(--sb-accent);
    text-decoration: none;
  }

  .sidebar-wrapper .footer-link .icon {
    display: inline-flex;
    color: var(--sb-muted);
  }

  .sidebar-wrapper .footer-link:hover .icon {
    color: var(--sb-accent);
  }

  .sidebar-wrapper .footer-link .icon .icon-svg {
    width: 17px;
    height: 17px;
  }

  /* ---------- Modo recolhido (largura via --sl-sidebar-width) ---------- */

  .sidebar-wrapper.collapsed .brand-text,
  .sidebar-wrapper.collapsed .section-title,
  .sidebar-wrapper.collapsed .item-label,
  .sidebar-wrapper.collapsed .group-label,
  .sidebar-wrapper.collapsed .chevron,
  .sidebar-wrapper.collapsed .footer-version,
  .sidebar-wrapper.collapsed .footer-link span:last-child {
    display: none;
  }

  .sidebar-wrapper.collapsed .sidebar-header {
    padding: 14px 0 10px;
  }

  .sidebar-wrapper.collapsed .brand-row {
    justify-content: center;
  }

  .sidebar-wrapper.collapsed .collapse-btn {
    display: none;
  }

  .sidebar-wrapper.collapsed .sidebar-nav {
    padding: 10px 8px 16px;
  }

  .sidebar-wrapper.collapsed .section-header {
    padding: 8px 0 2px;
    display: flex;
    justify-content: center;
  }

  .sidebar-wrapper.collapsed .section-header::after {
    content: '';
    width: 20px;
    height: 1px;
    background: var(--sb-border);
  }

  .sidebar-wrapper.collapsed .sidebar-item,
  .sidebar-wrapper.collapsed .sidebar-group-toggle {
    justify-content: center;
    padding: 8px 0;
  }

  .sidebar-wrapper.collapsed .sidebar-group-content {
    display: none;
  }

  .sidebar-wrapper.collapsed .sidebar-footer {
    padding: 12px 0;
    display: flex;
    justify-content: center;
  }

  .sidebar-wrapper.collapsed .footer-link {
    justify-content: center;
    padding: 8px;
  }

  /* Tooltip no modo recolhido */
  .sidebar-wrapper.collapsed [data-label]:hover::after {
    content: attr(data-label);
    position: absolute;
    left: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%);
    background: var(--sl-color-gray-6, #454159);
    color: var(--sl-color-bg-sidebar, #fff);
    font-size: 12px;
    font-weight: 550;
    padding: 6px 10px;
    border-radius: 6px;
    white-space: nowrap;
    z-index: 200;
    pointer-events: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  /* Botão flutuante p/ expandir quando recolhida */
  .sidebar-expand-fab {
    position: fixed;
    left: calc(var(--sl-sidebar-width, 68px) - 11px);
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 44px;
    border-radius: 0 8px 8px 0;
    border: 1px solid var(--sl-color-gray-2);
    border-left: none;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-text-muted);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 99;
    transition: color 0.16s ease;
  }

  .sidebar-expand-fab:hover {
    color: var(--sl-color-accent);
  }

  .sidebar-expand-fab .icon-svg {
    width: 13px;
    height: 13px;
  }

  body.sidebar-collapsed .sidebar-expand-fab {
    display: flex;
  }

  /* Overlay mobile */
  .sidebar-overlay {
    display: none;
  }

  @media (max-width: 1024px) {
    .sidebar-wrapper {
      transform: translateX(-102%);
      box-shadow: none;
    }

    .sidebar-wrapper.mobile-open {
      transform: translateX(0);
      box-shadow: 12px 0 48px rgba(0, 0, 0, 0.18);
    }

    .sidebar-wrapper.collapsed {
      width: 276px;
    }

    .sidebar-wrapper.collapsed .brand-text,
    .sidebar-wrapper.collapsed .section-title,
    .sidebar-wrapper.collapsed .item-label,
    .sidebar-wrapper.collapsed .group-label,
    .sidebar-wrapper.collapsed .chevron,
    .sidebar-wrapper.collapsed .footer-version,
    .sidebar-wrapper.collapsed .footer-link span:last-child {
      display: revert;
    }

    .sidebar-overlay.visible {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(18, 16, 27, 0.45);
      z-index: 90;
    }

    .sidebar-expand-fab {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-wrapper,
    .sidebar-wrapper .sidebar-group-content,
    .sidebar-wrapper .chevron .icon-svg,
    .sidebar-wrapper .collapse-btn .icon-svg {
      transition: none !important;
    }
  }
</style>

<div class="sidebar-wrapper" id="modum-sidebar">
  <aside class="sidebar" role="navigation" aria-label="Navegação principal">
    <header class="sidebar-header">
      <div class="brand-row">
        <div class="brand-mark" aria-hidden="true">M</div>
        <div class="brand-text">
          <span class="brand-title">MODUM</span>
          <span class="brand-subtitle">Manual do Sistema</span>
        </div>
        <button
          class="collapse-btn"
          aria-label="Recolher sidebar"
          aria-expanded="true"
          data-collapse-toggle
        >
          <span class="icon" aria-hidden="true" set:html={chevronLeftIconHtml} />
        </button>
      </div>
    </header>

    <nav class="sidebar-nav" aria-label="Seções do manual" set:html={navHtml} />

    <footer class="sidebar-footer">
      <div class="footer-version">
        <span>Manual</span>
        <span class="version-badge">v2.4</span>
      </div>
      <a href="https://wa.me/555591019112?text=Ol%C3%A1!%20Preciso%20de%20ajuda%20com%20o%20MODUM%20ERP." target="_blank" rel="noopener" class="footer-link">
        <span class="icon" aria-hidden="true" set:html={headphonesIconHtml} />
        <span>Falar com o suporte</span>
      </a>
    </footer>
  </aside>

  <button
    class="sidebar-expand-fab"
    aria-label="Expandir sidebar"
    data-expand-fab
  >
    <span class="icon" aria-hidden="true" set:html={menuIconHtml} />
  </button>
</div>
<div class="sidebar-overlay" data-sidebar-overlay></div>

<script>
  (() => {
    const wrapper = document.getElementById('modum-sidebar');
    const toggleBtn = wrapper?.querySelector('[data-collapse-toggle]');
    const expandFab = wrapper?.querySelector('[data-expand-fab]');
    const overlay = document.querySelector('[data-sidebar-overlay]');
    const sidebarPane = document.getElementById('starlight__sidebar');
    const mobileBreakpoint = 1024;
    let isCollapsed = false;
    let isMobileOpen = false;

    const isMobile = () => window.innerWidth <= mobileBreakpoint;
    const closeMobilePane = () => {
      if (sidebarPane && 'hidePopover' in sidebarPane) {
        sidebarPane.hidePopover();
      } else {
        setMobileOpen(false);
      }
    };

    function setCollapsed(collapsed) {
      isCollapsed = collapsed;
      wrapper?.classList.toggle('collapsed', collapsed);
      document.body.classList.toggle('sidebar-collapsed', collapsed && !isMobile());
      toggleBtn?.setAttribute('aria-expanded', String(!collapsed));
      toggleBtn?.setAttribute('aria-label', collapsed ? 'Expandir sidebar' : 'Recolher sidebar');
      try {
        localStorage.setItem('modum-sidebar-collapsed', String(collapsed));
      } catch {}
    }

    function setMobileOpen(open) {
      isMobileOpen = open;
      wrapper?.classList.toggle('mobile-open', open);
      overlay?.classList.toggle('visible', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    function bindGroupToggles() {
      wrapper?.querySelectorAll('.sidebar-group-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          const content = btn.nextElementSibling;
          if (!content || !content.classList.contains('sidebar-group-content')) return;
          const willOpen = !expanded;
          btn.setAttribute('aria-expanded', String(willOpen));
          btn.classList.toggle('expanded', willOpen);
          content.classList.toggle('open', willOpen);
        });
      });
    }

    const nav = wrapper?.querySelector('.sidebar-nav');
    const SCROLL_KEY = 'modum-sidebar-scroll';
    let scrollTick = false;

    // Mantém a sidebar na mesma posição ao navegar entre páginas.
    function restoreSidebarScroll() {
      if (!nav) return;
      try {
        const saved = sessionStorage.getItem(SCROLL_KEY);
        if (saved !== null) nav.scrollTop = parseInt(saved, 10) || 0;
      } catch {}
      // Garante o item ativo visível sem puxar a sidebar para o topo.
      const active = nav.querySelector('.sidebar-item.active, .sidebar-group-toggle.active');
      if (active && active.scrollIntoView) {
        try {
          active.scrollIntoView({ block: 'nearest' });
        } catch {}
      }
    }

    function trackSidebarScroll() {
      if (!nav || scrollTick) return;
      scrollTick = true;
      requestAnimationFrame(() => {
        scrollTick = false;
        try {
          sessionStorage.setItem(SCROLL_KEY, String(nav.scrollTop));
        } catch {}
      });
    }

    function handleKeydown(e) {
      if (e.key === 'Escape' && isMobileOpen) setMobileOpen(false);
    }

    function init() {
      let saved = null;
      try {
        saved = localStorage.getItem('modum-sidebar-collapsed');
      } catch {}
      if (saved !== null) setCollapsed(saved === 'true');
      else if (isMobile()) setCollapsed(false);

      bindGroupToggles();
      restoreSidebarScroll();
      nav?.addEventListener('scroll', trackSidebarScroll, { passive: true });
      toggleBtn?.addEventListener('click', () => {
        if (isMobile()) setMobileOpen(!isMobileOpen);
        else setCollapsed(!isCollapsed);
      });
      expandFab?.addEventListener('click', () => setCollapsed(false));
      overlay?.addEventListener('click', closeMobilePane);
      document.addEventListener('keydown', handleKeydown);

      // Sincroniza com o popover mobile nativo do Starlight (botão hambúrguer do header).
      sidebarPane?.addEventListener('toggle', (e) => {
        setMobileOpen(e.newState === 'open');
      });

      window.addEventListener('resize', () => {
        if (!isMobile()) {
          setMobileOpen(false);
          document.body.classList.toggle('sidebar-collapsed', isCollapsed);
        } else {
          document.body.classList.remove('sidebar-collapsed');
        }
      });

      document.addEventListener('click', (e) => {
        const t = e.target;
        if (t && t.closest && t.closest('[data-open-sidebar]')) setMobileOpen(true);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
