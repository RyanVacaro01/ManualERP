---
import type { SidebarGroup, SidebarItem } from '@astrojs/starlight';
import { getSidebar } from 'astro:config/client';

const sidebar = getSidebar();

const currentSlug = Astro.url.pathname;

const findActiveItem = (groups, currentPath) => {
  for (const group of groups) {
    for (const item of group.items) {
      if (item.type === 'link' && item.slug === currentPath) {
        return { group, item };
      }
      if (item.type === 'group' && item.items) {
        for (const child of item.items) {
          if (child.type === 'link' && child.slug === currentPath) {
            return { group, item: child, parent: item };
          }
          if (child.type === 'group' && child.items) {
            for (const grandChild of child.items) {
              if (grandChild.type === 'link' && grandChild.slug === currentPath) {
                return { group, item: grandChild, parent: child };
              }
            }
          }
        }
      }
    }
  }
  return null;
};

const activeInfo = findActiveItem(sidebar, currentSlug);

const iconMap: Record<string, string> = {
  'package': '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/><polyline points="3.27 17.04 12 12.01 20.73 17.04"/>',
  'users': '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'dollar-sign': '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  'shopping-bag': '<path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  'factory': '<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/><path d="M2 20h20"/><path d="M20 10h-2"/><path d="M14 4h-2"/><path d="M8 14h-2"/>',
  'truck': '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62L18.3 9.38a1 1 0 0 0-.78-.38H14"/><circle cx="17" cy="18" r="2"/><circle cx="5" cy="18" r="2"/>',
  'shopping-cart': '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
  'inbox': '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
  'user': '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  'globe': '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  'bar-chart-2': '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>',
  'folder': '<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/><line x1="2" y1="9" x2="22" y2="9"/>',
  'settings': '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  'home': '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  'play-circle': '<circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16"/>',
  'grid': '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
  'git-branch': '<line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  'plug': '<path d="M12 2v2"/><path d="M17 7h-10"/><path d="M10 7v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7"/><path d="M14 7v10a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V7"/>',
  'life-buoy': '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>',
  'book-open': '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/><line x1="2" y1="9" x2="22" y2="9"/>',
  'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
  'chevron-right': '<polyline points="9 18 15 12 9 6"/>',
  'chevron-left': '<polyline points="15 18 9 12 15 6"/>',
  'search': '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  'headphones': '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>',
  'external-link': '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>',
  'folder-open': '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
};

const getIcon = (iconName) => {
  const path = iconMap[iconName] || iconMap['file-text'];
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-svg">${path}</svg>`;
};

const moduleIcons: Record<string, string> = {
  'produtos': 'package',
  'clientes': 'users',
  'custos': 'dollar-sign',
  'pedidos': 'shopping-bag',
  'producao': 'factory',
  'expedicao': 'truck',
  'compras': 'shopping-cart',
  'recebimento': 'inbox',
  'pessoas': 'user',
  'marketplace': 'globe',
  'indicadores': 'bar-chart-2',
  'arquivos': 'folder',
  'extras': 'settings',
};

const groupIcons: Record<string, string> = {
  'inicio': 'home',
  'primeiros passos': 'play-circle',
  'modulos': 'grid',
  'fluxos de trabalho': 'git-branch',
  'integrações': 'plug',
  'ajuda': 'life-buoy',
  'referências': 'book-open',
};

const getIconForItem = (item, groupLabel) => {
  const slug = item.type === 'link' ? item.slug : '';
  
  for (const [key, icon] of Object.entries(moduleIcons)) {
    if (slug.includes(key)) return icon;
  }
  
  if (item.type === 'group') {
    const label = item.label.toLowerCase();
    for (const [key, icon] of Object.entries(groupIcons)) {
      if (label.includes(key)) return icon;
    }
  }
  
  return 'file-text';
};

const isItemActive = (item, parent) => {
  if (!activeInfo) return false;
  if (item.type === 'link' && item.slug === activeInfo.item.slug) return true;
  if (parent && parent.type === 'group' && parent.items?.some(i => i.type === 'link' && i.slug === activeInfo.item.slug)) return true;
  return false;
};

const isGroupExpanded = (group) => {
  if (!activeInfo) return group.collapsed !== true;
  return group.items.some(item => 
    (item.type === 'link' && item.slug === activeInfo.item.slug) ||
    (item.type === 'group' && item.items?.some(child => child.type === 'link' && child.slug === activeInfo.item.slug))
  );
};

const isItemExpanded = (item) => {
  if (!activeInfo) return item.collapsed !== true;
  if (item.type !== 'group') return false;
  return item.items?.some(child => 
    (child.type === 'link' && child.slug === activeInfo.item.slug) ||
    (child.type === 'group' && child.items?.some(gc => gc.type === 'link' && gc.slug === activeInfo.item.slug))
  ) ?? false;
};

const renderItem = (item, groupLabel, depth = 0, parent) => {
  const active = isItemActive(item, parent);
  const expanded = isItemExpanded(item);
  const hasChildren = item.type === 'group' && item.items && item.items.length > 0;
  const icon = getIconForItem(item, groupLabel);
  const indent = depth * 16;
  
  if (item.type === 'link') {
    return `
      <a 
        href="${item.slug}"
        class="sidebar-item ${active ? 'active' : ''} depth-${depth}"
        style="--indent: ${indent}px;"
        data-slug="${item.slug}"
      >
        <span class="item-icon" aria-hidden="true">${getIcon(icon)}</span>
        <span class="item-label">${item.label}</span>
        ${active ? '<span class="active-indicator" aria-hidden="true"></span>' : ''}
      </a>
    `;
  }
  
  if (item.type === 'group') {
    const childrenHtml = item.items?.map(child => renderItem(child, groupLabel, depth + 1, item)).join('') || '';
    const labelIcon = getIconForItem(item, groupLabel);
    
    return `
      <div class="sidebar-group depth-${depth}" style="--indent: ${indent}px;">
        <button 
          class="sidebar-group-toggle ${expanded ? 'expanded' : ''} ${active ? 'active' : ''}"
          data-group="${item.label}"
          aria-expanded="${expanded}"
          aria-controls="group-${item.label.replace(/\s+/g, '-').toLowerCase()}"
        >
          <span class="group-icon" aria-hidden="true">${getIcon(labelIcon)}</span>
          <span class="group-label">${item.label}</span>
          ${hasChildren ? `<span class="chevron" aria-hidden="true">${getIcon('chevron-right')}</span>` : ''}
          ${active ? '<span class="active-indicator" aria-hidden="true"></span>' : ''}
        </button>
        <div 
          id="group-${item.label.replace(/\s+/g, '-').toLowerCase()}"
          class="sidebar-group-content ${expanded ? 'open' : ''}"
          role="region"
          aria-label="${item.label}"
        >
          ${childrenHtml}
        </div>
      </div>
    `;
  }
  
  if (item.type === 'separator') {
    return '<hr class="sidebar-separator" aria-hidden="true" />';
  }
  
  return '';
}

const renderGroup = (group) => {
  const expanded = isGroupExpanded(group);
  const groupLabel = group.label.toLowerCase();
  const icon = groupIcons[groupLabel] || 'folder';
  const itemsHtml = group.items?.map(item => renderItem(item, group.label)).join('') || '';
  
  return `
    <section class="sidebar-section" aria-labelledby="section-${groupLabel.replace(/\s+/g, '-')}">
      <div class="section-header">
        <span class="section-icon" aria-hidden="true">${getIcon(icon)}</span>
        <h2 id="section-${groupLabel.replace(/\s+/g, '-')}" class="section-title">${group.label}</h2>
      </div>
      <div class="section-content ${expanded ? 'open' : ''}" data-section="${groupLabel}">
        ${itemsHtml}
      </div>
    </section>
  `;
}
---

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    background: var(--sl-color-bg-sidebar);
    border-right: 1px solid var(--sl-color-gray-2);
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    overflow-y: auto;
    overflow-x: hidden;
    width: var(--sidebar-width, 290px);
  }

  :host(.collapsed) {
    width: var(--sidebar-collapsed-width, 68px);
  }

  .sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--sl-color-gray-2);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :host(.collapsed) .sidebar-header {
    padding: 16px 12px;
    justify-content: center;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  :host(.collapsed) .header-content {
    opacity: 0;
    transform: translateX(-10px);
    pointer-events: none;
    width: 0;
    overflow: hidden;
  }

  .logo-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--sl-color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
  }

  .logo svg {
    width: 20px;
    height: 20px;
    color: white;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .logo-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--sl-color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  .logo-subtitle {
    font-size: 11px;
    font-weight: 400;
    color: var(--sl-color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .search-wrapper {
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 10px 12px 10px 38px;
    font-size: 13px;
    font-family: inherit;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 8px;
    outline: none;
    transition: all 0.15s ease;
  }

  .search-input::placeholder {
    color: var(--sl-color-text-muted);
  }

  .search-input:focus {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--sl-color-text-muted);
    pointer-events: none;
    transition: color 0.15s ease;
  }

  .search-icon .icon-svg {
    width: 16px;
    height: 16px;
  }

  .search-input:focus + .search-icon {
    color: var(--sl-color-accent);
  }

  .search-shortcut {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    color: var(--sl-color-text-muted);
    background: var(--sl-color-gray-1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .search-input:focus ~ .search-shortcut {
    opacity: 1;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 12px 8px;
    scrollbar-gutter: stable;
  }

  .sidebar-section {
    margin-bottom: 8px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    margin-bottom: 4px;
  }

  .section-icon {
    width: 14px;
    height: 14px;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
  }

  .section-icon .icon-svg {
    width: 14px;
    height: 14px;
  }

  .section-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--sl-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :host(.collapsed) .section-title {
    display: none;
  }

  .section-content {
    overflow: hidden;
    transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease;
  }

  .section-content:not(.open) {
    height: 0;
    opacity: 0;
  }

  .sidebar-group {
    margin-bottom: 2px;
  }

  .sidebar-group-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    font-family: inherit;
    color: var(--sl-color-text);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
    position: relative;
  }

  .sidebar-group-toggle:hover {
    background: var(--sl-color-gray-1);
    color: var(--sl-color-text);
  }

  .sidebar-group-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }

  .group-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .sidebar-group-toggle:hover .group-icon,
  .sidebar-group-toggle.active .group-icon {
    color: var(--sl-color-accent);
  }

  .group-icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .group-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  :host(.collapsed) .group-label {
    display: none;
  }

  .chevron {
    width: 16px;
    height: 16px;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chevron .icon-svg {
    width: 16px;
    height: 16px;
  }

  .sidebar-group-toggle.expanded .chevron {
    transform: rotate(90deg);
  }

  .sidebar-group-content {
    overflow: hidden;
    transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease, margin 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-group-content:not(.open) {
    height: 0;
    opacity: 0;
    margin-top: -4px;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px 9px calc(12px + var(--indent, 0px));
    border-radius: 8px;
    font-size: 13px;
    font-weight: 400;
    font-family: inherit;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: all 0.15s ease;
    position: relative;
    white-space: nowrap;
    overflow: hidden;
  }

  .sidebar-item:hover {
    background: var(--sl-color-gray-1);
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .sidebar-item:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }

  .sidebar-item.active {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 500;
  }

  .sidebar-item.active .item-icon {
    color: var(--sl-color-accent-high);
  }

  .sidebar-item.active:hover {
    background: var(--sl-color-accent-low);
  }

  .item-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .item-icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .sidebar-item:hover .item-icon {
    color: var(--sl-color-text);
  }

  .item-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  :host(.collapsed) .item-label {
    display: none;
  }

  .active-indicator {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: var(--sl-color-accent);
    border-radius: 0 4px 4px 0;
    flex-shrink: 0;
  }

  .sidebar-separator {
    border: none;
    border-top: 1px solid var(--sl-color-gray-2);
    margin: 8px 4px;
  }

  .sidebar-footer {
    padding: 12px 16px;
    border-top: 1px solid var(--sl-color-gray-2);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :host(.collapsed) .sidebar-footer {
    padding: 12px;
    justify-content: center;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  :host(.collapsed) .footer-content {
    opacity: 0;
    transform: translateX(-10px);
    pointer-events: none;
    width: 0;
    overflow: hidden;
  }

  .footer-version {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--sl-color-text-muted);
  }

  .version-badge {
    background: var(--sl-color-gray-1);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-weight: 500;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .footer-link:hover {
    background: var(--sl-color-gray-1);
    color: var(--sl-color-accent);
    text-decoration: none;
  }

  .footer-link .icon {
    width: 18px;
    height: 18px;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .footer-link .icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .footer-link:hover .icon {
    color: var(--sl-color-accent);
  }

  .collapse-toggle {
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--sl-color-text-muted);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    z-index: 10;
  }

  .collapse-toggle:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-text);
  }

  .collapse-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }

  .collapse-toggle .icon {
    width: 14px;
    height: 14px;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collapse-toggle .icon .icon-svg {
    width: 14px;
    height: 14px;
  }

  :host(.collapsed) .collapse-toggle .icon {
    transform: rotate(180deg);
  }

  @media (max-width: 1024px) {
    :host {
      transform: translateX(var(--sidebar-transform, 0));
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
    }

    :host(.mobile-open) {
      --sidebar-transform: 0;
    }

    :host:not(.mobile-open) {
      --sidebar-transform: -100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :host,
    .section-content,
    .sidebar-group-content,
    .header-content,
    .footer-content,
    .chevron,
    .collapse-toggle .icon {
      transition: none !important;
    }
  }
</style>

<div class="sidebar-wrapper">
  <aside class="sidebar" role="navigation" aria-label="Navegação principal">
    <header class="sidebar-header">
      <div class="header-content">
        <div class="logo-row">
          <div class="logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="3" width="7" height="7" rx="1.5" />
              <rect x="3" y="14" width="7" height="7" rx="1.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" />
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-title">MODUM ERP</span>
            <span class="logo-subtitle">Central de Ajuda</span>
          </div>
        </div>

        <div class="search-wrapper">
          <input
            type="search"
            class="search-input"
            placeholder="Buscar no manual..."
            aria-label="Buscar na documentação"
            autocomplete="off"
          />
          <span class="search-icon" aria-hidden="true">${getIcon('search')}</span>
          <kbd class="search-shortcut">⌘K</kbd>
        </div>
      </div>
    </header>

    <nav class="sidebar-nav" aria-label="Seções do manual">
      {sidebar.map(group => renderGroup(group))}
    </nav>

    <footer class="sidebar-footer">
      <div class="footer-content">
        <div class="footer-version">
          <span>Versão</span>
          <span class="version-badge">2.4.1</span>
        </div>
        <div class="footer-links">
          <a href="/troubleshoot/suporte" class="footer-link">
            <span class="icon" aria-hidden="true">${getIcon('headphones')}</span>
            <span>Falar com Suporte</span>
          </a>
          <a href="https://seuerp.com.br" target="_blank" rel="noopener" class="footer-link">
            <span class="icon" aria-hidden="true">${getIcon('external-link')}</span>
            <span>Portal do Cliente</span>
          </a>
        </div>
      </div>
    </footer>
  </aside>

  <button 
    class="collapse-toggle" 
    aria-label="Recolher sidebar"
    aria-expanded="true"
    data-collapse-toggle
  >
    <span class="icon" aria-hidden="true">${getIcon('chevron-left')}</span>
  </button>
</div>

<script>
  (() => {
    const sidebar = document.querySelector('.sidebar-wrapper');
    const toggleBtn = sidebar?.querySelector('[data-collapse-toggle]');
    const groupToggles = sidebar?.querySelectorAll('.sidebar-group-toggle');
    const sections = sidebar?.querySelectorAll('.section-content');
    const searchInput = sidebar?.querySelector('.search-input');
    const mobileBreakpoint = 1024;
    let isCollapsed = false;
    let isMobileOpen = false;

    function setCollapsed(collapsed) {
      isCollapsed = collapsed;
      sidebar?.classList.toggle('collapsed', collapsed);
      toggleBtn?.setAttribute('aria-expanded', String(!collapsed));
      toggleBtn?.setAttribute('aria-label', collapsed ? 'Expandir sidebar' : 'Recolher sidebar');
      localStorage.setItem('sidebar-collapsed', String(collapsed));
      
      document.documentElement.style.setProperty(
        '--sidebar-width', 
        collapsed ? '68px' : '290px'
      );
    }

    function setMobileOpen(open) {
      isMobileOpen = open;
      sidebar?.classList.toggle('mobile-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    function toggleCollapse() {
      if (window.innerWidth <= mobileBreakpoint) {
        setMobileOpen(!isMobileOpen);
      } else {
        setCollapsed(!isCollapsed);
      }
    }

    function handleGroupToggle(e) {
      const btn = e.currentTarget;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const content = btn.nextElementSibling;
      
      if (!content || !content.classList.contains('sidebar-group-content')) return;
      
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('expanded');
      content.classList.toggle('open');
    }

    function handleSearch() {
      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      const items = sidebar?.querySelectorAll('.sidebar-item, .sidebar-group-toggle') || [];
      
      items.forEach(item => {
        const label = item.querySelector('.item-label, .group-label');
        if (!label) return;
        const text = label.textContent.toLowerCase();
        const match = query === '' || text.includes(query);
        item.style.display = match ? '' : 'none';
      });

      sections?.forEach(section => {
        const visibleItems = section.querySelectorAll('.sidebar-item:not([style*="none"]), .sidebar-group-toggle:not([style*="none"])');
        const parentGroup = section.closest('.sidebar-section');
        if (parentGroup) {
          parentGroup.style.display = visibleItems.length > 0 ? '' : 'none';
        }
      });
    }

    function handleKeydown(e) {
      if (e.key === 'Escape') {
        if (isMobileOpen) setMobileOpen(false);
        if (searchInput?.matches(':focus')) searchInput.blur();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    }

    function init() {
      const saved = localStorage.getItem('sidebar-collapsed');
      if (saved !== null) {
        setCollapsed(saved === 'true');
      }

      if (window.innerWidth <= mobileBreakpoint) {
        setCollapsed(true);
        setMobileOpen(false);
      }

      toggleBtn?.addEventListener('click', toggleCollapse);
      groupToggles?.forEach(btn => btn.addEventListener('click', handleGroupToggle));
      searchInput?.addEventListener('input', handleSearch);
      document.addEventListener('keydown', handleKeydown);

      window.addEventListener('resize', () => {
        if (window.innerWidth > mobileBreakpoint) {
          setMobileOpen(false);
        } else if (!isCollapsed) {
          setCollapsed(true);
        }
      });

      document.addEventListener('click', (e) => {
        if (isMobileOpen && !sidebar?.contains(e.target) && !e.target.closest('[data-sidebar-toggle]')) {
          setMobileOpen(false);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>