---
import type { SidebarGroup, SidebarItem } from '@astrojs/starlight';
import { getSidebar } from 'astro:config/client';
import { 
  findActiveItem, 
  getIcon, 
  renderGroup, 
  ActiveInfo 
} from '../lib/sidebar';

const sidebar = getSidebar();
const currentSlug = Astro.url.pathname;

const activeInfo = findActiveItem(sidebar, currentSlug);
---

<style>
  :host {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    background: var(--sl-color-bg-sidebar);
    border-right: 1px solid var(--sl-color-gray-2);
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    overflow-y: auto;
    overflow-x: hidden;
    width: var(--sidebar-width, 290px);
  }

  :host(.collapsed) {
    width: var(--sidebar-collapsed-width, 68px);
  }

  .sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--sl-color-gray-2);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :host(.collapsed) .sidebar-header {
    padding: 16px 12px;
    justify-content: center;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  :host(.collapsed) .header-content {
    opacity: 0;
    transform: translateX(-10px);
    pointer-events: none;
    width: 0;
    overflow: hidden;
  }

  .logo-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--sl-color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
  }

  .logo svg {
    width: 20px;
    height: 20px;
    color: white;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .logo-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--sl-color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  .logo-subtitle {
    font-size: 11px;
    font-weight: 400;
    color: var(--sl-color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .search-wrapper {
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 10px 12px 10px 38px;
    font-size: 13px;
    font-family: inherit;
    color: var(--sl-color-text);
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-2);
    border-radius: 8px;
    outline: none;
    transition: all 0.15s ease;
  }

  .search-input::placeholder {
    color: var(--sl-color-text-muted);
  }

  .search-input:focus {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--sl-color-text-muted);
    pointer-events: none;
    transition: color 0.15s ease;
  }

  .search-icon .icon-svg {
    width: 16px;
    height: 16px;
  }

  .search-input:focus + .search-icon {
    color: var(--sl-color-accent);
  }

  .search-shortcut {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    color: var(--sl-color-text-muted);
    background: var(--sl-color-gray-1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .search-input:focus ~ .search-shortcut {
    opacity: 1;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 12px 8px;
    scrollbar-gutter: stable;
  }

  .sidebar-section {
    margin-bottom: 8px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    margin-bottom: 4px;
  }

  .section-icon {
    width: 14px;
    height: 14px;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
  }

  .section-icon .icon-svg {
    width: 14px;
    height: 14px;
  }

  .section-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--sl-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :host(.collapsed) .section-title {
    display: none;
  }

  .section-content {
    overflow: hidden;
    transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease;
  }

  .section-content:not(.open) {
    height: 0;
    opacity: 0;
  }

  .sidebar-group {
    margin-bottom: 2px;
  }

  .sidebar-group-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: none;
    background: transparent;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 500;
    font-family: inherit;
    color: var(--sl-color-text);
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
    position: relative;
  }

  .sidebar-group-toggle:hover {
    background: var(--sl-color-gray-1);
    color: var(--sl-color-text);
  }

  .sidebar-group-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }

  .group-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .sidebar-group-toggle:hover .group-icon,
  .sidebar-group-toggle.active .group-icon {
    color: var(--sl-color-accent);
  }

  .group-icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .group-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  :host(.collapsed) .group-label {
    display: none;
  }

  .chevron {
    width: 16px;
    height: 16px;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chevron .icon-svg {
    width: 16px;
    height: 16px;
  }

  .sidebar-group-toggle.expanded .chevron {
    transform: rotate(90deg);
  }

  .sidebar-group-content {
    overflow: hidden;
    transition: height 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease, margin 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .sidebar-group-content:not(.open) {
    height: 0;
    opacity: 0;
    margin-top: -4px;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px 9px calc(12px + var(--indent, 0px));
    border-radius: 8px;
    font-size: 13px;
    font-weight: 400;
    font-family: inherit;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: all 0.15s ease;
    position: relative;
    white-space: nowrap;
    overflow: hidden;
  }

  .sidebar-item:hover {
    background: var(--sl-color-gray-1);
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .sidebar-item:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }

  .sidebar-item.active {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 500;
  }

  .sidebar-item.active .item-icon {
    color: var(--sl-color-accent-high);
  }

  .sidebar-item.active:hover {
    background: var(--sl-color-accent-low);
  }

  .item-icon {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .item-icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .sidebar-item:hover .item-icon {
    color: var(--sl-color-text);
  }

  .item-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  :host(.collapsed) .item-label {
    display: none;
  }

  .active-indicator {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: var(--sl-color-accent);
    border-radius: 0 4px 4px 0;
    flex-shrink: 0;
  }

  .sidebar-separator {
    border: none;
    border-top: 1px solid var(--sl-color-gray-2);
    margin: 8px 4px;
  }

  .sidebar-footer {
    padding: 12px 16px;
    border-top: 1px solid var(--sl-color-gray-2);
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :host(.collapsed) .sidebar-footer {
    padding: 12px;
    justify-content: center;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  :host(.collapsed) .footer-content {
    opacity: 0;
    transform: translateX(-10px);
    pointer-events: none;
    width: 0;
    overflow: hidden;
  }

  .footer-version {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--sl-color-text-muted);
  }

  .version-badge {
    background: var(--sl-color-gray-1);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-weight: 500;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--sl-color-text);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .footer-link:hover {
    background: var(--sl-color-gray-1);
    color: var(--sl-color-accent);
    text-decoration: none;
  }

  .footer-link .icon {
    width: 18px;
    height: 18px;
    color: var(--sl-color-text-muted);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .footer-link .icon .icon-svg {
    width: 18px;
    height: 18px;
  }

  .footer-link:hover .icon {
    color: var(--sl-color-accent);
  }

  .collapse-toggle {
    position: absolute;
    right: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--sl-color-text-muted);
    transition: all 0.15s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    z-index: 10;
  }

  .collapse-toggle:hover {
    background: var(--sl-color-gray-1);
    border-color: var(--sl-color-gray-3);
    color: var(--sl-color-text);
  }

  .collapse-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }

  .collapse-toggle .icon {
    width: 14px;
    height: 14px;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collapse-toggle .icon .icon-svg {
    width: 14px;
    height: 14px;
  }

  :host(.collapsed) .collapse-toggle .icon {
    transform: rotate(180deg);
  }

  @media (max-width: 1024px) {
    :host {
      transform: translateX(var(--sidebar-transform, 0));
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
    }

    :host(.mobile-open) {
      --sidebar-transform: 0;
    }

    :host:not(.mobile-open) {
      --sidebar-transform: -100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :host,
    .section-content,
    .sidebar-group-content,
    .header-content,
    .footer-content,
    .chevron,
    .collapse-toggle .icon {
      transition: none !important;
    }
  }
</style>

<div class="sidebar-wrapper">
  <aside class="sidebar" role="navigation" aria-label="Navegação principal">
    <header class="sidebar-header">
      <div class="header-content">
        <div class="logo-row">
          <div class="logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="3" width="7" height="7" rx="1.5" />
              <rect x="3" y="14" width="7" height="7" rx="1.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" />
            </svg>
          </div>
          <div class="logo-text">
            <span class="logo-title">MODUM ERP</span>
            <span class="logo-subtitle">Central de Ajuda</span>
          </div>
        </div>

        <div class="search-wrapper">
          <input
            type="search"
            class="search-input"
            placeholder="Buscar no manual..."
            aria-label="Buscar na documentação"
            autocomplete="off"
          />
          <span class="search-icon" aria-hidden="true">{getIcon('search')}</span>
          <kbd class="search-shortcut">⌘K</kbd>
        </div>
      </div>
    </header>

    <nav class="sidebar-nav" aria-label="Seções do manual">
      {sidebar.map(group => renderGroup(group, activeInfo))}
    </nav>

    <footer class="sidebar-footer">
      <div class="footer-content">
        <div class="footer-version">
          <span>Versão</span>
          <span class="version-badge">2.4.1</span>
        </div>
        <div class="footer-links">
          <a href="/troubleshoot/suporte" class="footer-link">
            <span class="icon" aria-hidden="true">{getIcon('headphones')}</span>
            <span>Falar com Suporte</span>
          </a>
          <a href="https://seuerp.com.br" target="_blank" rel="noopener" class="footer-link">
            <span class="icon" aria-hidden="true">{getIcon('external-link')}</span>
            <span>Portal do Cliente</span>
          </a>
        </div>
      </div>
    </footer>
  </aside>

  <button 
    class="collapse-toggle" 
    aria-label="Recolher sidebar"
    aria-expanded="true"
    data-collapse-toggle
  >
    <span class="icon" aria-hidden="true">{getIcon('chevron-left')}</span>
  </button>
</div>

<script>
  (() => {
    const sidebar = document.querySelector('.sidebar-wrapper');
    const toggleBtn = sidebar?.querySelector('[data-collapse-toggle]');
    const groupToggles = sidebar?.querySelectorAll('.sidebar-group-toggle');
    const sections = sidebar?.querySelectorAll('.section-content');
    const searchInput = sidebar?.querySelector('.search-input');
    const mobileBreakpoint = 1024;
    let isCollapsed = false;
    let isMobileOpen = false;

    function setCollapsed(collapsed) {
      isCollapsed = collapsed;
      sidebar?.classList.toggle('collapsed', collapsed);
      toggleBtn?.setAttribute('aria-expanded', String(!collapsed));
      toggleBtn?.setAttribute('aria-label', collapsed ? 'Expandir sidebar' : 'Recolher sidebar');
      localStorage.setItem('sidebar-collapsed', String(collapsed));
      
      document.documentElement.style.setProperty(
        '--sidebar-width', 
        collapsed ? '68px' : '290px'
      );
    }

    function setMobileOpen(open) {
      isMobileOpen = open;
      sidebar?.classList.toggle('mobile-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    function toggleCollapse() {
      if (window.innerWidth <= mobileBreakpoint) {
        setMobileOpen(!isMobileOpen);
      } else {
        setCollapsed(!isCollapsed);
      }
    }

    function handleGroupToggle(e) {
      const btn = e.currentTarget;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const content = btn.nextElementSibling;
      
      if (!content || !content.classList.contains('sidebar-group-content')) return;
      
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.classList.toggle('expanded');
      content.classList.toggle('open');
    }

    function handleSearch() {
      if (!searchInput) return;
      const query = searchInput.value.toLowerCase().trim();
      const items = sidebar?.querySelectorAll('.sidebar-item, .sidebar-group-toggle') || [];
      
      items.forEach(item => {
        const label = item.querySelector('.item-label, .group-label');
        if (!label) return;
        const text = label.textContent.toLowerCase();
        const match = query === '' || text.includes(query);
        item.style.display = match ? '' : 'none';
      });

      sections?.forEach(section => {
        const visibleItems = section.querySelectorAll('.sidebar-item:not([style*="none"]), .sidebar-group-toggle:not([style*="none"])');
        const parentGroup = section.closest('.sidebar-section');
        if (parentGroup) {
          parentGroup.style.display = visibleItems.length > 0 ? '' : 'none';
        }
      });
    }

    function handleKeydown(e) {
      if (e.key === 'Escape') {
        if (isMobileOpen) setMobileOpen(false);
        if (searchInput?.matches(':focus')) searchInput.blur();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    }

    function init() {
      const saved = localStorage.getItem('sidebar-collapsed');
      if (saved !== null) {
        setCollapsed(saved === 'true');
      }

      if (window.innerWidth <= mobileBreakpoint) {
        setCollapsed(true);
        setMobileOpen(false);
      }

      toggleBtn?.addEventListener('click', toggleCollapse);
      groupToggles?.forEach(btn => btn.addEventListener('click', handleGroupToggle));
      searchInput?.addEventListener('input', handleSearch);
      document.addEventListener('keydown', handleKeydown);

      window.addEventListener('resize', () => {
        if (window.innerWidth > mobileBreakpoint) {
          setMobileOpen(false);
        } else if (!isCollapsed) {
          setCollapsed(true);
        }
      });

      document.addEventListener('click', (e) => {
        if (isMobileOpen && !sidebar?.contains(e.target) && !e.target.closest('[data-sidebar-toggle]')) {
          setMobileOpen(false);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>