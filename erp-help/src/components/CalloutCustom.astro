---
interface Props {
  title: string;
  icon?: string;
  type?: 'tip' | 'note' | 'warning' | 'caution';
}

const {
  title,
  icon = '💡',
  type = 'tip'
} = Astro.props;
---

<div
  class="callout-custom"
  data-callout={type}
>
  <div class="callout-header">
    <span class="callout-icon" aria-hidden="true">{icon}</span>
    <span class="callout-title">{title}</span>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout-custom {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--sl-color-gray-2);
    border-left: 3px solid var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text);
    box-shadow: 0 1px 2px rgba(35, 32, 47, 0.05);
  }

  .callout-custom[data-callout='tip'] {
    border-left-color: #22c55e;
  }

  .callout-custom[data-callout='note'] {
    border-left-color: var(--sl-color-accent);
  }

  .callout-custom[data-callout='warning'] {
    border-left-color: #f59e0b;
  }

  .callout-custom[data-callout='caution'] {
    border-left-color: #ef4444;
  }
  
  .callout-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  
  .callout-icon {
    font-size: 1.25rem;
  }
  
  .callout-title {
    font-size: 1rem;
  }
  
  .callout-content {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  
  .callout-content :global(p) {
    margin: 0;
  }
  
  .callout-content :global(ul) {
    margin: 0.5rem 0 0;
    padding-left: 1.5rem;
  }
  
  .callout-content :global(li) {
    margin: 0.25rem 0;
  }
</style>
